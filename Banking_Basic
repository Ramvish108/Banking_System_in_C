#include <stdio.h>
#include <string.h>

#define MAX_ATTEMPTS 3


void checkBalance(double balance);
double depositMoney(double balance);
double withdrawMoney(double balance);
double transferMoney(double *balance);
void accountInformation(int accountNumber, double balance,
                        const char status[]);

int main(void)
{
    int loginId, pin;
    int correctLoginId = 101;
    int correctPin = 1234;
    int attempts = 0;
    int authenticated = 0;
    int choice;

    int accountNumber = 123456789;
    const char accountStatus[] = "Active";
    double balance = 10000.00;

    printf("====================================\n");
    printf("       WELCOME TO BANKING SYSTEM\n");
    printf("====================================\n");

    
    while (attempts < MAX_ATTEMPTS)
    {
        printf("\nEnter Login ID: ");

        if (scanf("%d", &loginId) != 1)
        {
            printf("Invalid input. Please enter numbers only.\n");
            return 1;
        }

        printf("Enter PIN: ");

        if (scanf("%d", &pin) != 1)
        {
            printf("Invalid input. Please enter numbers only.\n");
            return 1;
        }

        if (loginId == correctLoginId && pin == correctPin)
        {
            authenticated = 1;
            break;
        }

        attempts++;
        printf("Incorrect Login ID or PIN!\n");
        printf("Attempts remaining: %d\n",
               MAX_ATTEMPTS - attempts);
    }

    if (!authenticated)
    {
        printf("\nAccess denied. Too many failed attempts.\n");
        return 0;
    }

    printf("\nLogin successful! Welcome to your account.\n");

    
    do
    {
        printf("\n========== BANKING MENU ==========\n");
        printf("1. Check Balance\n");
        printf("2. Deposit Money\n");
        printf("3. Withdraw Money\n");
        printf("4. Transfer Money\n");
        printf("5. Account Information\n");
        printf("6. Exit\n");
        printf("==================================\n");
        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1)
        {
            printf("Invalid input. Please restart the program "
                   "and enter a number.\n");
            return 1;
        }

        switch (choice)
        {
            case 1:
                checkBalance(balance);
                break;

            case 2:
                balance = depositMoney(balance);
                break;

            case 3:
                balance = withdrawMoney(balance);
                break;

            case 4:
                transferMoney(&balance);
                break;

            case 5:
                accountInformation(accountNumber, balance,
                                   accountStatus);
                break;

            case 6:
                printf("\nThank you for using our Banking System.\n");
                printf("Goodbye!\n");
                break;

            default:
                printf("Invalid choice! Please select 1 to 6.\n");
        }

    } while (choice != 6);

    return 0;
}


void checkBalance(double balance)
{
    printf("\nCurrent Account Balance: Rs. %.2f\n", balance);
}


double depositMoney(double balance)
{
    double amount;

    printf("\nEnter amount to deposit: Rs. ");

    if (scanf("%lf", &amount) != 1)
    {
        printf("Invalid amount.\n");
        return balance;
    }

    if (amount <= 0)
    {
        printf("Deposit amount must be greater than zero.\n");
    }
    else
    {
        balance += amount;
        printf("Deposit successful!\n");
        printf("Updated Balance: Rs. %.2f\n", balance);
    }

    return balance;
}


double withdrawMoney(double balance)
{
    double amount;

    printf("\nEnter amount to withdraw: Rs. ");

    if (scanf("%lf", &amount) != 1)
    {
        printf("Invalid amount.\n");
        return balance;
    }

    if (amount <= 0)
    {
        printf("Withdrawal amount must be greater than zero.\n");
    }
    else if (amount > balance)
    {
        printf("Insufficient balance!\n");
    }
    else
    {
        balance -= amount;
        printf("Withdrawal successful!\n");
        printf("Remaining Balance: Rs. %.2f\n", balance);
    }

    return balance;
}


double transferMoney(double *balance)
{
    int receiverAccount;
    int ownAccount = 123456789;
    double amount;

    printf("\nEnter receiver account number: ");

    if (scanf("%d", &receiverAccount) != 1)
    {
        printf("Invalid account number.\n");
        return *balance;
    }

    if (receiverAccount <= 0 || receiverAccount == ownAccount)
    {
        printf("Invalid receiver account number.\n");
        return *balance;
    }

    printf("Enter amount to transfer: Rs. ");

    if (scanf("%lf", &amount) != 1)
    {
        printf("Invalid amount.\n");
        return *balance;
    }

    if (amount <= 0)
    {
        printf("Transfer amount must be greater than zero.\n");
    }
    else if (amount > *balance)
    {
        printf("Insufficient balance for transfer!\n");
    }
    else
    {
        *balance -= amount;
        printf("Transfer successful!\n");
        printf("Receiver Account: %d\n", receiverAccount);
        printf("Transferred Amount: Rs. %.2f\n", amount);
        printf("Remaining Balance: Rs. %.2f\n", *balance);
    }

    return *balance;
}

void accountInformation(int accountNumber, double balance,
                        const char status[])
{
    printf("\n======= ACCOUNT INFORMATION =======\n");
    printf("Account Number : %d\n", accountNumber);
    printf("Account Status : %s\n", status);
    printf("Current Balance: Rs. %.2f\n", balance);
    printf("===================================\n");
}
